# SvelteKit / Node
node_modules
/build
/.svelte-kit
/package
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Environment variables
.env
.env.*
!.env.example

# Rust build artifacts
**/target/

# Game data tables — loaded at runtime from LOA Logs installation (%LOCALAPPDATA%\LOA Logs\meter-data\)
# Do not commit these; they go stale and are always present if LOA Logs is installed.
src-tauri/meter-data/

# Tauri generated schemas
# https://github.com/tauri-apps/tauri/discussions/8323#discussioncomment-8984252
src-tauri/gen/schemas

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Windows junk
Thumbs.db
Desktop.ini
*.lnk

# macOS junk
.DS_Store

# Generic logs (npm/yarn covered above; this catches anything else)
*.log

# Test coverage output
coverage/

# Claude Code project config — local-only, not for the public repo
.claude/

# Local Claude Code session notes (see CLAUDE.md — never commit CLAUDE.local.md)
CLAUDE.local.md

# Audit reports — internal artifacts, kept locally only
audit-*.md

# Tauri signing keys — never commit
.tauri/

# Release staging — generated artifacts for GitHub Releases, not source
release-staging/

# JetBrains IDEs
.idea/

# Superpowers brainstorm sessions
.superpowers/
docs/superpowers/

# Playwright MCP session logs
.playwright-mcp/
